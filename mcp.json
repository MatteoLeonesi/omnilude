{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "omnilude": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--directory",
        "${PLUGIN_ROOT}",
        "omnilude",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
